# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Buckets
S3_RAW_BUCKET=kyc-dev-raw-documents
S3_PROCESSED_BUCKET=kyc-dev-processed-documents
S3_PRESIGNED_URL_EXPIRY=300

# SQS Queues
SQS_INGESTION_QUEUE_URL=
SQS_PROCESSING_QUEUE_URL=
SQS_REVIEW_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=

# SNS Topics
SNS_STATUS_TOPIC_ARN=
SNS_TEXTRACT_TOPIC_ARN=

# Database
DATABASE_URL=postgresql://kyc_admin:password@localhost:5432/kyc_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# KMS
KMS_KEY_ID=

# Textract
TEXTRACT_ROLE_ARN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
